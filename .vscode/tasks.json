{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restore GeoTagNinja packages",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\msbuild.ps1",
        "-Action",
        "Restore"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build GeoTagNinja (Debug x64)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\msbuild.ps1",
        "-Action",
        "Build"
      ],
      "dependsOn": "Restore GeoTagNinja packages",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run GeoTagNinja (Debug x64)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\msbuild.ps1",
        "-Action",
        "Run"
      ],
      "dependsOn": "Build GeoTagNinja (Debug x64)",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Test GeoTagNinja",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\msbuild.ps1",
        "-Action",
        "Test"
      ],
      "dependsOn": "Build GeoTagNinja (Debug x64)",
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
