<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia pre-release UI. Targets modern .NET on purpose: the WinForms app stays on net48 until it is
       replaced, and this project is the one that replaces it. Windows 10 and 11 only (x64). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>GeoTagNinja.Avalonia</AssemblyName>
    <RootNamespace>GeoTagNinja.Avalonia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Not part of the end-user flow yet: keeps the exe distinguishable from the WinForms build. -->
    <Product>GeoTagNinja (Avalonia pre-release)</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoTagNinja.Core\GeoTagNinja.Core.csproj" />
  </ItemGroup>

</Project>
