<Project Sdk="WixToolset.Sdk/7.0.0">
  <!-- Installer for GeoTagNinja (WiX v7, builds an .msi). Replaces the old Visual Studio Installer Projects
       GeoTagNinja_Setup.vdproj. It packages the *Release* build output of GeoTagNinja.csproj, so build that first
       (`msbuild.ps1 -Action Installer` does both). Not in GeoTagNinja.sln on purpose: Visual Studio cannot open a .wixproj without the HeatWave extension. -->
  <PropertyGroup>
    <!-- Keep the file name: APIVersionCheckers downloads releases/download/b<build>/GeoTagNinja_Setup.msi by this name. -->
    <OutputName>GeoTagNinja_Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- WiX v7 ships under the Open Source Maintenance Fee EULA. The fee only applies above US$10,000 a year in
         revenue; GeoTagNinja is free, so accepting the EULA ("wix7") here is all that is needed. -->
    <AcceptEula>wix7</AcceptEula>
    <!-- ICE61: AllowSameVersionUpgrades="yes" (deliberate, see Package.wxs) makes it warn that the upgrade range is
         not strictly older. ICE60: harmless "no language on an unversioned file" for the bundled non-binary files. -->
    <SuppressIces>ICE60;ICE61</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where the main app's Release output lives (see Directory.Build.props). Override with /p:AppBinDir=... -->
    <AppBinDir Condition="'$(AppBinDir)' == ''">$(LOCALAPPDATA)\build\GeoTagNinja\GeoTagNinja\bin\Release\</AppBinDir>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</RepoRoot>
    <DefineConstants>$(DefineConstants);AppBinDir=$(AppBinDir);RepoRoot=$(RepoRoot)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>

  <Target Name="CheckAppBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AppBinDir)GeoTagNinja.exe')"
           Text="GeoTagNinja.exe not found in $(AppBinDir). Build GeoTagNinja.csproj in Release first (a Release solution build does this)." />
  </Target>
</Project>
