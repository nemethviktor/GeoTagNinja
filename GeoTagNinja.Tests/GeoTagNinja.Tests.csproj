<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The tests deliberately run under a variety of cultures, so the invariant-globalisation
         switch some SDKs default to must stay off. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>GeoTagNinja.Tests</AssemblyName>
    <RootNamespace>GeoTagNinja.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoTagNinja.csproj" />
  </ItemGroup>

  <!-- Release builds only succeed if the tests pass. Debug builds are left alone so the
       edit-build loop stays fast; run the tests explicitly there. A failing test makes
       Exec return a non-zero exit code, which fails the build. -->
  <Target Name="RunTestsOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet test &quot;$(TargetPath)&quot; --nologo" />
  </Target>

</Project>
