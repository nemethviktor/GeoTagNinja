<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The tests deliberately run under a variety of cultures, so the invariant-globalisation
         switch some SDKs default to must stay off. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>GeoTagNinja.Tests</AssemblyName>
    <RootNamespace>GeoTagNinja.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoTagNinja.csproj" />
  </ItemGroup>

</Project>
